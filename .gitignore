*.pdf
!tests/fixtures/*.pdf

# Registry (shared across clones, not in repo)
papers_registry.json

# IDE / OS artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# pytest cache
.pytest_cache/

# Coverage reports
.coverage
htmlcov/
