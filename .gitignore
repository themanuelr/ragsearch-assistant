# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.egg-info/
dist/
build/

# Local config (per-clone, gitignored per CLAUDE.md)
config.json

# Vault (per-project, gitignored per CLAUDE.md)
